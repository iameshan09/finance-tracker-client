@inherits LayoutComponentBase

<MudThemeProvider/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <div class="page">
        <div class="sidebar">
            <NavMenu/>
        </div>
        <MudMainContent>
            <Header/>
            <div class="p-4">
